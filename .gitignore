# === 必须排除（平台相关，无法跨平台同步）===

# Python 编译缓存（自动生成，平台相关）
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（必须在每台机器上重建）
venv/
.venv/
env/

# pytest 缓存
.pytest_cache/

# 打包产物
*.egg-info/
dist/
build/
*.egg

# === 可选排除（IDE 和 OS 文件）===

# IDE 配置（如果你想同步 IDE 设置可以去掉这几行）
.idea/
.vscode/
*.swp
*.swo

# 操作系统临时文件
.DS_Store
Thumbs.db

# Qoder 编辑器缓存（自动生成，不需要同步）
.qoder/

# === 以下内容全部同步（报告、日志、截图、产出）===
# 注意：如果截图/报告文件太大导致 push 慢，可以取消下面的注释来排除
# ui_automation/evidence/screenshots/*.png
# reports/html/
# reports/allure/
# logs/*.log
