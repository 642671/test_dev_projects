# ===========================================================
# === 必须排除（平台相关，无法跨平台同步）===
# ===========================================================

# Python 编译缓存（自动生成，平台相关）
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（必须在每台机器上重建）
venv/
.venv/
env/

# pytest 缓存
.pytest_cache/

# 打包产物
*.egg-info/
dist/
build/
*.egg

# ===========================================================
# === 本地覆盖配置（每台机器各自维护，不同步）===
# ===========================================================

# local.yaml 本地覆盖配置文件
# 每个模块的 config/local.yaml 用于覆盖环境差异配置（如服务器地址）
# 模板文件 local.yaml.example 会同步，实际使用的 local.yaml 不同步
**/local.yaml

# ===========================================================
# === volcano_proxy（仅 Mac 使用，Windows 不需要同步）===
# ===========================================================

# 整个 volcano_proxy 目录排除（含 API Key、SSL 证书、Mac shell 脚本）
volcano_proxy/

# ===========================================================
# === 可选排除（IDE 和 OS 文件）===
# ===========================================================

# IDE 配置（如果你想同步 IDE 设置可以去掉这几行）
.idea/
.vscode/
*.swp
*.swo

# 操作系统临时文件
.DS_Store
Thumbs.db

# Qoder 编辑器缓存（自动生成，不需要同步）
.qoder/

# ===========================================================
# === 测试产物（截图、报告、日志）===
# ===========================================================

# UI 自动化失败截图和报告（每次运行自动生成）
test_automation/ui_automation/reports/screenshots/
test_automation/ui_automation/reports/*.html
test_automation/ui_automation/reports/*.json

# 日志文件（运行产物，按需同步）
# 如需同步历史日志可注释掉下面两行
logs/*.log
**/logs/*.log

# ===========================================================
# === 以下内容全部同步（报告、日志、截图、产出）===
# ===========================================================
# 注意：如果截图/报告文件太大导致 push 慢，可以取消下面的注释来排除
# test_automation/ui_automation/evidence/screenshots/*.png
# reports/html/
# reports/allure/

# ===========================================================
# === 临时文件归档（不提交到 Git）===
# ===========================================================
archives/
verify_screenshots/
temp_scripts/

# Node.js 依赖
node_modules/

# 本地编辑器状态
.obsidian/

# 非工程生成资产
itachi-v2-run/
itachi-validate.json

# 个人素材（用户本地维护，勿动）
miaoqi/

# 存储管理安装包仅本地保留；版本目录说明可正常提交
storagemanager/**/*.deb

# 本机 Codex 认证、会话与探针备份，不上传
docs/codex-model-integration/backups/
docs/codex-model-integration/direct-newapi-probe/
docs/codex-model-integration/scripts/minirouter/router.log
