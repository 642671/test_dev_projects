#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
case "${1:-}" in remove|purge) ;; *) exit 0 ;; esac
command -v mountpoint >/dev/null 2>&1 || { echo 'Refusing cleanup without mountpoint validation' >&2; exit 1; }
# Only these installation roots can be cleaned. Never follow a redirected
# directory or guess the installation volume from a device name.
valid_app_root() {
  case "$1" in
    /usr/local/diskcheck) ;;
    /Volume*/@apps/diskcheck)
      volume_number=${1#/Volume}; volume_number=${volume_number%/@apps/diskcheck}
      case "$volume_number" in ''|*[!0-9]*) return 1;; esac ;;
    *) return 1 ;;
  esac
  [ "$(readlink -f -- "$1")" = "$1" ]
}
app_root=$(readlink -f /usr/local/diskcheck 2>/dev/null || true)
if [ -f /run/diskcheck-uninstall/app-root ] && [ ! -L /run/diskcheck-uninstall ]; then
  app_root=$(cat /run/diskcheck-uninstall/app-root)
fi
case "${1:-}" in
  remove|purge)
    if valid_app_root "$app_root"; then
      # These are generated by postinst/TOS, not tracked by dpkg. Symlinks
      # are unlinked themselves; a mounted web directory is never traversed.
      if [ -L "$app_root/webui" ]; then
        rm -f -- "$app_root/webui"
      elif [ -d "$app_root/webui" ] && ! mountpoint -q -- "$app_root/webui"; then
        rm -rf -- "$app_root/webui"
      fi
      rm -f -- "$app_root/ROUTER" "$app_root/.userid"
      rmdir -- "$app_root" 2>/dev/null || true
    fi
    ;;
esac
rm -f /var/api/diskcheck.sock /run/diskcheck/helper.sock /run/diskcheck-mail/mail.sock
if [ -f /etc/nginx/conf.d/diskcheck.conf ]; then
  rm -f -- /etc/nginx/conf.d/diskcheck.conf
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx >/dev/null 2>&1 || true; fi
fi
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "${1:-}" = "purge" ]; then
  if valid_app_root "$app_root"; then
    for relative in depends/data depends/logs; do
      target="$app_root/$relative"
      if [ "$(readlink -f -- "$target")" = "$target" ] && ! mountpoint -q -- "$target"; then rm -rf -- "$target"; fi
    done
  fi
  backup=/Volume1/@apps/diskcheck-user-data
  if [ "$(readlink -f -- "$backup")" = "$backup" ] && ! mountpoint -q -- "$backup"; then rm -rf -- "$backup"; fi
  if getent passwd diskcheck >/dev/null 2>&1; then deluser diskcheck >/dev/null 2>&1 || true; fi
  if getent group diskcheck >/dev/null 2>&1; then delgroup diskcheck >/dev/null 2>&1 || true; fi
fi
case "${1:-}" in
  remove|purge) rm -f /run/diskcheck-uninstall/app-root; rmdir /run/diskcheck-uninstall 2>/dev/null || true ;;
esac
exit 0
