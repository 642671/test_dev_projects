          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="响应断言-状态码403(未登录正常)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="51511">403</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">GET /v2/login 未登录时应返回403并携带RSA公钥</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="03-用户登录" enabled="true">
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/v2/login</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;username&quot;:&quot;${USERNAME}&quot;,&quot;password&quot;:&quot;${encrypted_password}&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223预处理器-RSA加密密码" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
import java.security.KeyFactory
import java.security.spec.X509EncodedKeySpec
import javax.crypto.Cipher

// 获取从响应头提取的 RSA 公钥（Base64编码）
def rsaTokenBase64 = vars.get(&quot;rsa_public_key&quot;)

if (rsaTokenBase64 == null || rsaTokenBase64 == &quot;RSA_KEY_NOT_FOUND&quot;) {
    log.error(&quot;未能获取RSA公钥，请检查上一步请求&quot;)
    throw new Exception(&quot;RSA公钥未获取到&quot;)
}

// Base64 解码公钥
def publicKeyPEM = new String(rsaTokenBase64.decodeBase64())

// 清理 PEM 格式，提取纯 Base64 内容
def publicKeyContent = publicKeyPEM
    .replace(&quot;-----BEGIN PUBLIC KEY-----&quot;, &quot;&quot;)
    .replace(&quot;-----END PUBLIC KEY-----&quot;, &quot;&quot;)
    .replaceAll(&quot;\\s+&quot;, &quot;&quot;)

// 生成公钥对象
def keyBytes = publicKeyContent.decodeBase64()
def keySpec = new X509EncodedKeySpec(keyBytes)
def keyFactory = KeyFactory.getInstance(&quot;RSA&quot;)
def publicKey = keyFactory.generatePublic(keySpec)

// RSA 加密密码
def cipher = Cipher.getInstance(&quot;RSA/ECB/PKCS1Padding&quot;)
cipher.init(Cipher.ENCRYPT_MODE, publicKey)

def password = vars.get(&quot;PLAIN_PASSWORD&quot;) ?: &quot;admin&quot;
def encryptedBytes = cipher.doFinal(password.getBytes(&quot;UTF-8&quot;))

// Base64 编码加密结果
def encryptedPassword = encryptedBytes.encodeBase64().toString()

// 存储加密后的密码
vars.put(&quot;encrypted_password&quot;, encryptedPassword)

// 如果从响应头未获取到CSRF Token，尝试使用Cookie中的值
def csrfToken = vars.get(&quot;csrf_token&quot;)
if (csrfToken == null || csrfToken == &quot;CSRF_NOT_FOUND&quot;) {
    def csrfCookie = vars.get(&quot;csrf_token_cookie&quot;)
    if (csrfCookie != null &amp;&amp; csrfCookie != &quot;CSRF_COOKIE_NOT_FOUND&quot;) {
        vars.put(&quot;csrf_token&quot;, csrfCookie)
        log.info(&quot;使用Cookie中的CSRF Token&quot;)
    }
}

log.info(&quot;密码加密完成&quot;)
</stringProp>
          </JSR223PreProcessor>
