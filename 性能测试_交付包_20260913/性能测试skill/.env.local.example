# =============================================================================
# 性能测试 skill · 被测机凭据模板
# =============================================================================
#
# 用法：把本文件复制成同目录下的 `.env.local`，再填真实值。
#
#     cp .env.local.example .env.local
#
# ⚠️ 规则：**本文件只写变量名与示例值，绝不写真实凭据。**
#    真实值一律写进 `.env.local` —— 它已被工作区根 `.gitignore` 排除，不会入库。
#    同理，README / SKILL.md / 上下文速查里也只写变量名（如 `TOS_PASS`），不写值。
#
# ⚠️ 两条写法要求（`sshcommon.load_env()` 的解析很简单：按第一个 `=` 切分后只做 strip）：
#    1. **值不要加引号** —— `TOS_PASS="abc"` 会把引号也当成口令的一部分。
#    2. **值后面不要跟行内注释** —— 例如写成
#           TOS_PORT=9222  # SSH 端口
#       会把 `9222  # SSH 端口` 整段当值，`creds()` 在 int() 处直接 ValueError。
#       所以**注释一律另起一行**（以 `#` 开头），下面四行就是这么排的。
#
# 读取顺序（`scripts/sshcommon.py` 的 `load_env()`，**不覆盖已有环境变量**）：
#     1. 进程环境变量（最高优先级）
#     2. 本 skill 根目录的 `.env.local`
#     3. 当前工作目录的 `.env.local`
#
# 所以 `TOS_HOST=10.18.15.179 python scripts/perf_lifecycle.py ...` 这种临时写法
# 会盖掉 `.env.local` 里的值 —— 要连另一台机器时不必改文件。
# =============================================================================

# 被测机 IP 或主机名（必填）。例：TOS 测试机 10.18.15.179
TOS_HOST=
# 登录用户名
TOS_USER=
# 登录口令
TOS_PASS=
# SSH 端口（默认 9222）
TOS_PORT=9222

# -----------------------------------------------------------------------------
# 可选：连接行为（一般不用动，出问题时再调）
# -----------------------------------------------------------------------------

# 连接重试次数（默认 3）。
# ⚠️ **认证失败不重试** —— 反复试密码会触发 PAM 锁账号（约 5 分钟），越试越登不上。
#    本项只对「端口能 accept 但收不到 banner」这类瞬时故障生效。
# SSH_RETRIES=3      # 连接重试次数（认证失败不重试，避免 PAM 锁账号）

# 单次等待 SSH banner 的秒数（默认 20）。机器刚重启 / sshd 正忙时调大。
# SSH_BANNER_TIMEOUT=20

# 每次重试前的等待秒数（默认 5）。
# SSH_RETRY_WAIT=5

# 单条远程命令超时秒数（默认 120）。
# SSH_TIMEOUT=120

# -----------------------------------------------------------------------------
# 可选：依赖自举开关
# -----------------------------------------------------------------------------

# 设为 1 则缺 Python 依赖时**只提示不自动安装**（给人选择权）。
# 缺 paramiko 时默认会自动 `pip install paramiko` 并打印一行 `[自举] …`。
# 内网 / 离线机器建议设 1，免得卡在 pip 超时上。
# SKILL_NO_AUTO_INSTALL=1   # 设为 1 则缺依赖只提示不自动安装

# -----------------------------------------------------------------------------
# 可选：老机器兼容 / 调试
# -----------------------------------------------------------------------------

# 老 dropbear / 老 sshd 只认 ssh-rsa 时设为 1（paramiko 默认禁用 ssh-rsa）。
# TOS_LEGACY=1

# 设为 1 时打印 paramiko 的原始异常栈，排查连接问题时用。
# SSH_DEBUG=1

# -----------------------------------------------------------------------------
# 可选：压测工具落地目录（`scripts/perf_run.py` 用）
# -----------------------------------------------------------------------------

# 压测器（k6 / JMeter）的查找目录。
# 不设则默认 `%USERPROFILE%\.perf-tools`（POSIX 下 `~/.perf-tools`）。
# 设了就在这里找 `k6\k6.exe` / `jmeter\bin\ApacheJMeter.jar`，也用于打印安装指引。
# PERF_TOOLS_ROOT=D:\perf-tools
