          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="SA-01 获取公钥与令牌" enabled="true">
            <stringProp name="TestPlan.comments">超级管理员获取公钥 X-Rsa-Token 和 CSRF Token</stringProp>
            <stringProp name="HTTPSampler.path">/tos/</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
