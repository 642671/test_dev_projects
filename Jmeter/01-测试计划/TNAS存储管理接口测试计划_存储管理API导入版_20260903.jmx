          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="ADM-01 查看管理员本次新增变量" enabled="true">
            <stringProp name="TestPlan.comments">只显示公钥和CSRF的提取摘要</stringProp>
