            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="SA-03 登录状态日志" enabled="true">
              <stringProp name="TestPlan.comments">输出登录状态响应和会话变量是否准备好的摘要，不打印完整 Cookie/Token 值</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="language">groovy</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def responseText = prev.getResponseDataAsString()
def isLogin = 'N/A'
def businessCode = 'N/A'
def codeNum = 'N/A'
def codeMsg = 'N/A'
try {
    def json = new groovy.json.JsonSlurper().parseText(responseText)
    isLogin = String.valueOf(json.is_login)
    businessCode = String.valueOf(json.code)
    codeNum = String.valueOf(json.code_num)
    codeMsg = String.valueOf(json.code_msg)
} catch (Exception e) {
    log.warn('SA-03 响应不是合法 JSON：' + e.message)
}

def csrf = vars.get('super_admin_csrf_token')
def tms = vars.get('super_admin_cookie_TMSESSNAME')
def cookie = vars.get('super_admin_cookie')

log.info('===== SA-03 登录状态日志 =====')
log.info('response = ' + responseText)
log.info('is_login = ' + isLogin)
log.info('code = ' + businessCode)
log.info('code_num = ' + codeNum)
log.info('code_msg = ' + codeMsg)
log.info('csrf_token = ' + (csrf ? '已获取（长度=' + csrf.length() + '）' : '未获取'))
log.info('TMSESSNAME = ' + (tms ? '已获取（长度=' + tms.length() + '）' : '未获取'))
log.info('cookie = ' + (cookie ? '已获取（长度=' + cookie.length() + '）' : '未获取'))
log.info('===== SA-03 日志结束 =====')
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
