  <stringProp name="TestPlan.comments">Apifox ID 507035197 | GET /v2/storage/MountPool/{role}/{uuid} | 目录 存储池</stringProp>
  <stringProp name="HTTPSampler.path">/v2/storage/MountPool/${role}/${uuid}</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
  <boolProp name="HTTPSampler.auto_redirects">false</boolProp>
