  expect: __expect
};

try {
(function() {
// ============================================================
// GET /v2/hotsparedisk/GetRaidHotSpare 后置脚本
// 提取所有支持热备的存储池 vgs 名称，
// 生成 hs{N}_vg（如 hs1_vg = vg0），供创建热备盘使用
// ------------------------------------------------------------
// POST /v2/hotsparedisk/CreateHotSpareDisk 请求体示例：
//   { "devices": ["{{hs1_device}}"], "raids": ["{{hs1_vg}}"] }
// ============================================================

const res = pm.response.json();
const data = res.data || res;

function setOrUnset(key, val) {
    if (val === undefined || val === null || val === '' || Number.isNaN(val)) {
        pm.moduleVariables.unset(key);
    } else {
        pm.moduleVariables.set(key, val);
    }
}

// ============================================================
// 0. 清理所有旧的 hs{N}_vg 变量
// ============================================================
const allModuleVars = pm.moduleVariables.toObject();
Object.keys(allModuleVars)
    .filter(k =&gt; /^hs\d+_vg$/.test(k))
    .forEach(k =&gt; pm.moduleVariables.unset(k));

// ============================================================
// 1. 标准化为数组
// ============================================================
let pools;
if (Array.isArray(data)) {
    pools = data;
} else if (data &amp;&amp; typeof data === 'object') {
    pools = [data];
} else {
    pools = [];
}

if (pools.length === 0) {
    console.log('无支持热备的存储池，所有 hs_vg 变量已清空');
    pm.moduleVariables.set('hs_vg_count', 0);
    return;
}

// ============================================================
// 2. 提取每个池的 vgs 名称，按数组顺序从 1 起编号
// ============================================================
const vgNames = [];
pools.forEach(p =&gt; {
    const vgName = (p.vgs || '').trim();
    if (vgName) vgNames.push(vgName);
});

if (vgNames.length === 0) {
    console.log('无有效 vgs 名称，所有 hs_vg 变量已清空');
    pm.moduleVariables.set('hs_vg_count', 0);
    return;
}

// 按原数组顺序写入 hs{N}_vg（N 从 1 起）
vgNames.forEach((name, i) =&gt; {
    const idx = i + 1;
    pm.moduleVariables.set(`hs${idx}_vg`, name);
    console.log(`hs${idx}_vg = ${name}`);
});

pm.moduleVariables.set('hs_vg_count', vgNames.length);
pm.moduleVariables.set('hs_vg_list', JSON.stringify(vgNames));

// ============================================================
// 3. 调试输出
// ============================================================
console.log(`==== 热备存储池同步结果 ====`);
console.log(`支持热备的存储池: ${vgNames.length} 个 → ${vgNames.join(', ')}`);

const updatedVars = pm.moduleVariables.toObject();
const hsVgVars = Object.keys(updatedVars)
    .filter(k =&gt; /^hs\d+_vg$/.test(k))
    .sort((a, b) =&gt; parseInt(a.match(/\d+/)[0]) - parseInt(b.match(/\d+/)[0]));

if (hsVgVars.length &gt; 0) {
    console.log('---------- hs{N}_vg 明细 ----------');
    hsVgVars.forEach(k =&gt; console.log(`${k} = ${updatedVars[k]}`));
}
console.log('=======================================');

})();
} catch (e) {
log.warn('[ApifoxJS] ' + e);
}</stringProp>
  <stringProp name="scriptLanguage">javascript</stringProp>
</JSR223PostProcessor>
