  "execution_order": {
    "description": "接口测试用例执行时的依赖顺序，必须先执行变量生成接口，再执行使用接口",
    "steps": [
      {
        "order": 1,
        "path": "GET /v2/welcome",
        "produces": [
          "RSA_PUBLIC_KEY"
        ],
        "note": "登录前置"
      },
      {
        "order": 2,
        "path": "POST /v2/login",
        "produces": [
          "Cookie",
          "X-Csrf-Token"
        ],
        "note": "认证基础"
      },
      {
        "order": "L2",
        "path": "POST /v2/logout",
        "produces": [
          "expired_Cookie",
          "expired_X-Csrf-Token",
          "wrong_X-Csrf-Token"
        ],
        "note": "凭证失效变量（负向测试前置）"
      },
      {
        "order": "L2",
        "path": "POST /v2/logout",
        "produces": [
          "expired_Cookie",
          "expired_X-Csrf-Token",
          "wrong_X-Csrf-Token"
        ],
        "note": "凭证失效变量（负向测试前置）"
      },
      {
        "order": 3,
        "path": "POST /v2/otp/verify_pwd",
        "produces": [
          "X-Curpass-Token"
        ],
        "note": "敏感操作密码验证"
      },
      {
        "order": 4,
        "path": "GET /v2/storage/list/storagePool",
        "produces": [
          "vg{N}_uuid",
          "vg_count",
          "avail_*",
          "corrupt_*"
        ],
        "note": "存储池同步"
      },
      {
        "order": 5,
        "path": "GET /v2/storage/list/volume",
        "produces": [
          "lv{N}_uuid",
          "lv{N}_filesystem",
          "lv_count"
        ],
        "note": "卷同步"
      },
      {
        "order": 6,
        "path": "GET /v2/disk/GetDiskOption",
        "produces": [
          "cap_disk{N}",
          "disk{N}_device",
          "disk{N}",
          "disk_count"
        ],
        "note": "磁盘同步"
      },
      {
        "order": 7,
        "path": "GET /v2/storage/edit/pool/{uuid}",
        "produces": [
          "vg{N}_raid",
          "vg{N}_md",
          "vg{N}_check_disk"
        ],
        "note": "存储池详情"
      },
      {
        "order": 8,
        "path": "GET /v2/storage/edit/volume/{uuid}",
        "produces": [
          "lv{N}_mnt_path",
          "lv{N}_sort"
        ],
        "note": "卷详情"
      },
      {
        "order": 9,
        "path": "GET /v2/disk/GetDiskDetailData",
        "produces": [
          "diskN_model",
          "diskN_serial",
          "diskN_type",
          "diskN_capacity",
          "diskN_slot"
        ],
        "note": "磁盘详情"
      },
      {
        "order": 10,
        "path": "GET /v2/storage/create/volume",
        "produces": [
          "cv_*"
        ],
        "note": "创建卷资源"
      },
      {
        "order": 11,
        "path": "GET /v2/storage/create/pool",
        "produces": [
          "cp_*"
        ],
        "note": "创建池资源"
      },
      {
        "order": 12,
        "path": "GET /v2/disk/smart_test/schedule",
        "produces": [
          "diskN_smart_id",
          "smart_task_count"
        ],
        "note": "SMART 任务同步"
      },
      {
        "order": 13,
        "path": "GET /v2/disk/IhmInfoList",
        "produces": [
          "Ihm{N}_device",
          "Ihm{N}_name",
          "Ihm{N}_model",
          "Ihm{N}_health",
          "Ihm_count",
          "Ihm_disk_list"
        ],
        "note": "IHM 健康扫描磁盘同步"
      },
      {
        "order": 14,
        "path": "GET /v2/hotsparedisk/GetAvailableDiskList",
        "produces": [
          "hs{N}_device",
          "hs{N}_name",
          "hs_disk_count"
        ],
        "note": "热备磁盘同步"
      },
      {
        "order": 15,
        "path": "GET /v2/hotsparedisk/GetRaidHotSpare",
        "produces": [
          "hs{N}_vg",
          "hs_vg_count",
          "hs_vg_list"
        ],
        "note": "热备存储池同步"
      },
