# ============================================================
# UI 自动化 - 本地覆盖配置模板
# ============================================================
# 使用方法：
#   1. 复制本文件为 local.yaml（在同目录下）
#   2. 修改 local.yaml 中的配置项为你本机的值
#   3. local.yaml 已被 .gitignore 排除，不会提交到 Git
#
#   Mac:   cp ui_automation/config/local.yaml.example ui_automation/config/local.yaml
#   Win:   Copy-Item ui_automation\config\local.yaml.example ui_automation\config\local.yaml
#
# 覆盖规则：
#   - 先加载 environments/{TEST_ENV}.yaml 作为基础配置
#   - 再用本文件中的值进行深度合并覆盖
#   - 只需填写你想覆盖的项，不需要全部列出
# ============================================================

# --- 最常用的覆盖项 ---

# TOS 服务器地址（家里/公司不同）
# Mac（家里）示例：
#   base_url: "http://localhost:8181"
# Windows（公司）示例：
#   base_url: "http://192.168.64.7:8181"
# base_url: "http://localhost:8181"

# --- 其他可选覆盖项（按需取消注释）---

# 登录账号（如果不同机器用不同账号）
# username: "your_username"
# password: "your_password"

# 浏览器配置（例如公司机器想用无头模式）
# browser:
#   headless: true
#   implicit_wait: 15
